# Copy to secrets.pending.env and fill ONLY new plaintext variables.
# Already-encrypted keys (B, C, …) stay in encrypted-secrets/local.env — do not repeat them here.
#
# Example: B and C are encrypted; only add A:
# VAR_A=my-new-secret-value
#
# Then run:
#   make secrets-add FILE=config/env/secrets.pending.env
#   make secrets-decrypt

# Azure (when using storage / ADF from local pipeline)
# AZURE_STORAGE_CONNECTION_STRING=...

# SQL Server
# MSSQL_SA_PASSWORD=Olist@Dev123!
