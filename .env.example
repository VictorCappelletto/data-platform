# Copy to .env for local runs (never commit .env)
# Or use encrypted secrets: docs/secrets-pipeline.md (make secrets-init / secrets-decrypt)
DATA_PLATFORM_ROOT=.
DATA_PLATFORM_APP=medalion_ingestion_project
PLATFORM_ENV=local
LAKE_ROOT=./data/lake
LAKE_BACKEND=local
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DEMO_DB_PASSWORD=changeme
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AIRFLOW_UID=50000

# Azure SQL — senha via SOPS (make secrets-set); FQDN vem do deploy
# AZURE_SQL_SERVER=
# AZURE_SQL_ADMIN_LOGIN=olistadmin
# AZURE_SQL_OLIST_DATABASE=olist
# AZURE_SQL_DW_DATABASE=olist_dw

# SQL Server local (legacy / dev offline) — docker compose service: sqlserver
MSSQL_SA_PASSWORD=Olist@Dev123!
MSSQL_SERVER=localhost,1433
MSSQL_DATABASE=olist
MSSQL_USER=sa

# Azure ADLS Gen2 — set after infra deploy (docker/azure/sync-deploy-outputs.ps1)
# AZURE_STORAGE_ACCOUNT=
# AZURE_ADLS_ENDPOINT=
# AZURE_DATA_FACTORY_NAME=
# AZURE_ACR_NAME=
# AZURE_ACR_LOGIN_SERVER=
# AZURE_BATCH_ACCOUNT_NAME=
# AZURE_BATCH_ACCOUNT_URL=
# AZURE_BATCH_POOL_NAME=olist-pool
# AZURE_BATCH_STORAGE_ACCOUNT_NAME=
# AZURE_TRANSFORM_IMAGE=
# AZURE_BATCH_POOL_IDENTITY_CLIENT_ID=
# ODBC / pyodbc connection string (optional)
# MSSQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=olist;Uid=sa;Pwd=Olist@Dev123!;TrustServerCertificate=yes;
# BREWERY_USE_FIXTURE=1
# BREWERY_API_URL=https://api.openbrewerydb.org/v1/breweries
